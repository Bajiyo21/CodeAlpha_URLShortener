{
  "installCommand": "pip install --disable-pip-version-check -r requirements.txt",
  "buildCommand": "./build_files.sh",
  "outputDirectory": "staticfiles",
  "builds": [
    {
      "src": "backend/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/wsgi.py"
    }
  ]
}